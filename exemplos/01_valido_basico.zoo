~ 01_valido_basico: declaração, atribuição e saída ~

ENTRAR_NA_JAULA
    cobra bicho = "Leao Simba"
    carneirinho idade = 5
    camaleao kg_de_carne = 12.5
    vagalume ta_na_jaula = vivo

    idade = idade + 1
    kg_de_carne = kg_de_carne + 2.5

    rugir("ROARRR! BEM-VINDO AO ZOOLOGICO DA ZOOLANG!")
    rugir(bicho)
    rugir(idade)
    rugir(kg_de_carne)
    rugir(ta_na_jaula)
SAIR_DA_JAULA
