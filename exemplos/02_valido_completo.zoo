~ ==================================================
  02_valido_completo: condicional, repetição,
  entrada/saída e expressões com precedência
  ================================================== ~

gato math

ENTRAR_NA_JAULA
    fossil carneirinho ESTOQUE_IDEAL = 100
    carneirinho bananas
    carneirinho refeicao = 1
    camaleao consumo = 0.0
    carneirinho resultado

    ~ precedência: 2 + (3 * 4) = 14 e (2 + 3) * 4 = 20 ~
    resultado = 2 + 3 * 4
    rugir(resultado)
    resultado = (2 + 3) * 4
    rugir(resultado)

    rugir("Quantas bananas chegaram para os macacos?")
    capturar(bananas)

    se_tem_bicho (bananas >= ESTOQUE_IDEAL) {
        rugir("BANANA PRA TODO MUNDO! OS MACACOS FIZERAM FESTA!")
    } Se_for_outro_bixo (bananas >= 50) {
        rugir("Da pro gasto, mas o gorila ficou de olho.")
    } nao_tem_bicho {
        rugir("Pouca banana! Os macacos entraram em greve!")
    }

    contar_carneirinho (refeicao <= 3) {
        consumo = consumo + bananas * 0.5
        rugir("Refeicao " + refeicao + " dos macacos servida!")
        refeicao = refeicao + 1
    }

    migrar (carneirinho i = 10; i > 0; i = i - 1) {
        se_tem_bicho (i == 5) {
            rugir("O leao escapou! Todo mundo foge!")
            fugir
        }
        rugir(i)
    }

    rugir("Bananas consumidas: " + consumo)
    rugir("ZOOLOGICO FECHADO! BOA NOITE, BICHOS!")
SAIR_DA_JAULA
